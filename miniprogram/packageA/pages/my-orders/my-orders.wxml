<view class="page">
  <view class="loading" wx:if="{{loading}}">加载中...</view>

  <view class="empty" wx:elif="{{orders.length === 0}}">
    <view class="empty-text">还没有点过菜哦</view>
    <view class="go-btn" bindtap="goHome">去选菜</view>
  </view>

  <block wx:else>
    <view class="order-card" wx:for="{{orders}}" wx:key="_id">
      <view class="order-head">
        <text class="order-no">{{item.orderNo}}</text>
        <text class="status-tag status-{{item.status}}">{{statusText[item.status] || item.status}}</text>
      </view>
      <view class="order-time">{{item.createTime}}</view>
    <view class="order-addr" wx:if="{{item.address}}">{{item.address.name}}　{{item.address.phone}}　{{item.address.address}}</view>
      <view class="order-items">
        <view class="order-item" wx:for="{{item.items}}" wx:for-item="dish" wx:key="id">
          <text>{{dish.name}}</text>
          <text class="item-count">x{{dish.count}}</text>
        </view>
      </view>
      <view class="order-remark" wx:if="{{item.remark}}">备注：{{item.remark}}</view>
      <view class="order-foot" wx:if="{{item.totalAmount}}">
        合计：<text class="price">¥{{item.totalAmount}}</text>
      </view>
    </view>
  </block>
</view>
