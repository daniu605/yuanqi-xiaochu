.page {
  min-height: 100vh;
  background-color: #FFF6F6;
  padding-bottom: 140rpx;
  box-sizing: border-box;
}

.category-bar {
  display: flex;
  white-space: nowrap;
  background-color: #fff;
  padding: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.category-item {
  display: inline-block;
  font-size: 26rpx;
  color: #666;
  padding: 14rpx 30rpx;
  border-radius: 30rpx;
  margin-right: 16rpx;
  background-color: #f6f6f6;
}

.category-item.active {
  background: linear-gradient(to right, #FF7A9E, #FF5777);
  color: #fff;
}

.category-item.add-cat {
  background-color: #fff;
  color: #FF7A9E;
  border: 1rpx dashed #FFC0CB;
}

.dish-list {
  padding: 30rpx;
}

.empty {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 80rpx 0;
}

.dish-card {
  display: flex;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  align-items: center;
}

.dish-image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background-color: #f5f5f5;
  flex-shrink: 0;
}

.dish-info {
  flex: 1;
  padding: 0 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.dish-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.popular-tag {
  font-size: 20rpx;
  color: #fff;
  background: linear-gradient(to right, #FF7A9E, #FF5777);
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
  margin-left: 10rpx;
  vertical-align: middle;
}

.dish-desc {
  font-size: 24rpx;
  color: #999;
  margin: 8rpx 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-portion {
  font-size: 24rpx;
  color: #FF7A9E;
  background-color: #FFF0F3;
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
  align-self: flex-start;
}

.dish-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.action-btn {
  font-size: 24rpx;
  padding: 10rpx 30rpx;
  border-radius: 30rpx;
  text-align: center;
}

.action-btn.edit {
  background-color: #FFF0F3;
  color: #FF5777;
}

.action-btn.delete {
  background-color: #f6f6f6;
  color: #999;
}

.add-btn {
  position: fixed;
  bottom: 30rpx;
  left: 30rpx;
  right: 30rpx;
  height: 90rpx;
  background: linear-gradient(to right, #FF7A9E, #FF5777);
  border-radius: 45rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
  box-shadow: 0 4rpx 10rpx rgba(255, 87, 119, 0.3);
  z-index: 100;
}

/* 表单弹窗 */
.form-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 999;
}

.form-panel {
  width: 100%;
  background-color: #fff;
  border-radius: 30rpx 30rpx 0 0;
  padding: 40rpx 30rpx;
  box-sizing: border-box;
  max-height: 85vh;
  overflow-y: auto;
}

.form-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 30rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-item.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.form-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.form-item.row .form-label {
  margin-bottom: 0;
}

.form-input {
  background-color: #f8f8f8;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
}

.picker-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.picker-row .form-picker {
  flex: 1;
}

.add-cat-link {
  color: #FF5777;
  font-size: 26rpx;
  padding: 20rpx;
  flex-shrink: 0;
}

.form-picker {
  background-color: #f8f8f8;
  border-radius: 12rpx;
  padding: 20rpx;
}

.picker-text {
  font-size: 28rpx;
  color: #333;
}

.image-picker {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background-color: #f8f8f8;
}

.preview-image {
  width: 100%;
  height: 100%;
}

.image-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 24rpx;
  border: 1rpx dashed #ddd;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.form-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}

.form-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 40rpx;
  font-size: 30rpx;
}

.form-btn.cancel {
  background-color: #f6f6f6;
  color: #666;
}

.form-btn.confirm {
  background: linear-gradient(to right, #FF7A9E, #FF5777);
  color: #fff;
}
