<view class="page">
  <!-- 顶部分类栏 -->
  <scroll-view class="category-bar" scroll-x enable-flex>
    <view
      wx:for="{{categories}}"
      wx:key="id"
      class="category-item {{activeCategoryId === item.id ? 'active' : ''}}"
      bindtap="switchCategory"
      bindlongpress="onDeleteCategory"
      data-id="{{item.id}}"
      data-name="{{item.name}}"
    >
      {{item.name}}
    </view>
    <view class="category-item add-cat" bindtap="onAddCategory">+ 分类</view>
  </scroll-view>

  <!-- 菜品列表 -->
  <view class="dish-list">
    <view class="empty" wx:if="{{!filteredDishes.length}}">该分类下暂无菜品</view>
    <view class="dish-card" wx:for="{{filteredDishes}}" wx:key="_id">
      <image class="dish-image" src="{{item.image}}" mode="aspectFill"></image>
      <view class="dish-info">
        <view class="dish-name">
          {{item.name}}
          <text class="popular-tag" wx:if="{{item.isPopular}}">热门</text>
        </view>
        <view class="dish-desc" wx:if="{{item.description}}">{{item.description}}</view>
        <view class="dish-portion" wx:if="{{item.portion}}">{{item.portion}}</view>
      </view>
      <view class="dish-actions">
        <view class="action-btn edit" catchtap="onEdit" data-dish="{{item}}">编辑</view>
        <view class="action-btn delete" catchtap="onDelete" data-id="{{item._id}}">删除</view>
      </view>
    </view>
  </view>

  <!-- 新增按钮 -->
  <view class="add-btn" bindtap="onAdd">+ 新增菜品</view>

  <!-- 编辑/新增表单弹窗 -->
  <view class="form-mask" wx:if="{{showForm}}" bindtap="closeForm">
    <view class="form-panel" catchtap="noop">
      <view class="form-title">{{isEdit ? '编辑菜品' : '新增菜品'}}</view>

      <view class="form-item">
        <view class="form-label">菜品图片</view>
        <view class="image-picker" bindtap="chooseImage">
          <image wx:if="{{form.image}}" src="{{form.image}}" mode="aspectFill" class="preview-image"></image>
          <view wx:else class="image-placeholder">点击上传图片</view>
        </view>
      </view>

      <view class="form-item">
        <view class="form-label">菜名</view>
        <input class="form-input" placeholder="请输入菜名" value="{{form.name}}" bindinput="onNameInput" />
      </view>

      <view class="form-item">
        <view class="form-label">份量</view>
        <input class="form-input" placeholder="如：2-3人份" value="{{form.portion}}" bindinput="onPortionInput" />
      </view>

      <view class="form-item">
        <view class="form-label">描述</view>
        <input class="form-input" placeholder="请输入描述（选填）" value="{{form.description}}" bindinput="onDescInput" />
      </view>

      <view class="form-item">
        <view class="form-label">所属分类</view>
        <view class="picker-row">
          <picker class="form-picker" range="{{categories}}" range-key="name" value="{{categoryIndex}}" bindchange="onCategoryChange">
            <view class="picker-text">{{categories[categoryIndex].name || '请选择分类'}}</view>
          </picker>
          <view class="add-cat-link" bindtap="onAddCategory">+ 新增分类</view>
        </view>
      </view>

      <view class="form-item row">
        <view class="form-label">设为热门</view>
        <switch checked="{{form.isPopular}}" color="#FF7A9E" bindchange="onPopularChange" />
      </view>

      <view class="form-btns">
        <view class="form-btn cancel" bindtap="closeForm">取消</view>
        <view class="form-btn confirm" bindtap="saveDish">{{saving ? '保存中...' : '保存'}}</view>
      </view>
    </view>
  </view>
</view>
